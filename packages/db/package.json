{
  "name": "@opendevelopment/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:init-timescale": "tsx scripts/init-timescaledb.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opendevelopment/shared-types": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "pg": "^8.13.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@opendevelopment/typescript-config": "workspace:*",
    "@opendevelopment/eslint-config": "workspace:*",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
