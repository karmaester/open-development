# ===========================================
# OpenDevelopment Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.

# --- Database (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opendevelopment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opendevelopment

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Application ---
NODE_ENV=development
PORT=3001

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Authentication (future use) ---
# JWT_SECRET=your-jwt-secret-here
# JWT_EXPIRES_IN=7d

# --- Data Connectors (future use) ---
# WORLD_BANK_API_URL=https://api.worldbank.org/v2
# WHO_GHO_API_URL=https://ghoapi.azurewebsites.net/api
